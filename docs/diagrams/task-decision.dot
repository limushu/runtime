digraph decision {
  graph [rankdir=TB, bgcolor="transparent", pad=0.3, nodesep=0.4, ranksep=0.5];
  node [shape=box, style="rounded,filled", fontname="Arial", color="#64748b", fillcolor="#f8fafc", fontcolor="#0f172a"];
  edge [fontname="Arial", color="#475569", fontcolor="#334155"];
  request [label="RequestEnvelope", shape=oval, fillcolor="#eef2ff"];
  handler [label="Service::handle -> Handler Future", fillcolor="#dbeafe"];
  poll [label="HandlerSet polls Future", fillcolor="#e0f2fe"];
  choice [label="needs managed control scope?", shape=diamond, fillcolor="#fef3c7"];
  plain [label="continue without Task", fillcolor="#dcfce7"];
  manager [label="Service::create_new_task\nServiceTaskManager admission", fillcolor="#f3e8ff"];
  result [label="Handler Result\nreply or TaskTicket terminal", fillcolor="#dcfce7"];
  request -> handler -> poll -> choice;
  choice -> plain [label=" no"];
  choice -> manager [label=" yes"];
  plain -> result;
  manager -> result [label=" TaskContext"];
}
