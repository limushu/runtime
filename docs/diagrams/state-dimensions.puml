@startuml
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam componentStyle rectangle
left to right direction

rectangle "Pool" as Pool {
  component Lifecycle
  component Health
  component "Activity Set" as Activity
}

rectangle "MemberDisk domain truth" as MD {
  database "Persisted MemberDisk fields (SDB)\nidentity/tier/capacity/topology\nshrink intent/io/allocation/membership/bitmap" as Decision
  component "Operational Projection\nUA / DA / DI / UI / REMOVED" as DiskState
}

component "DiskMap Event\nUP / DOWN" as PhysicalState

rectangle "Runtime observation projection" as Runtime {
  component "ObjectTaskCoordinator\nactive / pending / cancellation / waiter" as ReconcileActivity
  component "Operation / Task / Trace\nprogress / blocked_on / transitions" as TaskView
  component "Service Lifecycle + Idle/Busy" as ServiceView
}

rectangle "PoolNode" as PN {
  component Membership
  component "Connectivity\n来自 NodeMap" as Connectivity
  component "Pool ServiceState" as ServiceState
}

rectangle "BGEntry" as Entry {
  component "MediaState\n由 MemberDisk 派生" as MediaState
  component DataState
}

Entry --> Health : BG -> VD -> Pool 派生
PhysicalState --> MD : MemberDiskEvent input
PhysicalState --> MediaState : current media fact
Decision --> DiskState : io + allocation + membership
ReconcileActivity ..> DiskState : drives but never owns truth
TaskView ..> DiskState : observes transitions only
ServiceView --> Activity
Connectivity --> ServiceState : necessary but insufficient

note bottom of Pool
PoolState = Lifecycle × Health × Activity
end note

note bottom of PN
Connected(n) 不代表 PoolServing(p,n)
end note

note bottom of Runtime
运行状态和观测记录都不是领域权威
Monitor 切主后从 SDB + 当前外部事实重新收敛
end note
@enduml
