@startuml
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam componentStyle rectangle
left to right direction

actor "Pool / 调用者" as Owner
actor "TUI / 审计" as Tui

package "ServiceInstance<Message>" {
  component "ServiceClient\ntyped call(Request)" as Client
  component "ServiceControl\nPause / Resume / Drain / Stop\nCancelTask" as Control
  component "ServiceObserver\nSnapshot / Event stream / History" as Observer
  component "ServiceTask\nroot ownership / abort / join" as TaskOwner

  rectangle "ServiceRuntime: one root Tokio task" as Root {
    component "priority control poll" as ControlPoll
    component "business admission\nbounded + max in-flight" as Admission
    component "FuturesUnordered\nhandler Futures" as Futures
    component "Lifecycle\nInit / Run / Pause / Drain / Stop" as Lifecycle
    component "ObservationHub\nOperation / Task / Trace" as Hub
  }
}

package "MemberDisk adaptation" {
  component "MemberDiskMessage\none explicit protocol match" as Message
  component "MemberDiskService\nnormal async business methods" as Service
  component "ObjectTaskCoordinator\nDiskUuid -> active + pending\nTaskControl / WaitIdle" as Objects
  database "committed MemberDisk directory" as Metadata
}

component "PoolNode / VDM / Metadata clients" as Dependencies

Owner --> Client : business request
Owner --> Control : out-of-band control
Owner --> TaskOwner : owns root lifetime
Tui --> Observer : read / subscribe
Client --> Admission : message + typed oneshot
Control --> ControlPoll
ControlPoll --> Lifecycle
Admission --> Futures : service.handle(...) Future
Futures --> Message
Message --> Service
Service --> Objects : optional object admission
Service --> Hub : optional start_task / progress / transition
Service --> Metadata : read / SDB-first publish
Service --> Dependencies : explicit target client + await
Objects --> Hub : precise Task cancellation
Lifecycle --> Hub
Hub --> Observer
TaskOwner --> Root : join or final force-drop

note bottom of Root
一个 Service 只有一个根 Tokio task
每个请求是 Future，但 Query 不必创建 Task
控制通道独立且在 select 中优先
end note

note bottom of Objects
仅提供 Join / Queue / Cancel / Promotion 机制
Key 与冲突规则由 MemberDisk 决定
不保存领域状态，不创建每对象 task
end note

note bottom of Hub
Snapshot/Event 是观测投影，不是业务 WAL
Operation 是因果身份，Task 是一次执行尝试
end note
@enduml
