digraph runtime {
  graph [rankdir=LR, bgcolor="transparent", pad=0.3, nodesep=0.45, ranksep=0.65];
  node [shape=box, style="rounded,filled", fontname="Arial", color="#64748b", fillcolor="#f8fafc", fontcolor="#0f172a", margin="0.16,0.10"];
  edge [fontname="Arial", color="#475569", fontcolor="#334155"];
  caller [label="Caller", shape=oval, fillcolor="#eef2ff"];
  client [label="ServiceClient\ncall / submit / send"];
  executor [label="Service Executor\none Tokio task", fillcolor="#dbeafe", color="#2563eb"];
  handlers [label="HandlerSet\nFuturesUnordered", fillcolor="#e0f2fe", color="#0284c7"];
  handle [label="Service::handle\nasync Future", fillcolor="#dcfce7", color="#16a34a"];
  metadata [label="Service core metadata", shape=cylinder, fillcolor="#fef3c7", color="#d97706"];
  tasks [label="ServiceTaskManager\nslots / policy / cancellation\n(no Futures)", fillcolor="#f3e8ff", color="#9333ea"];
  router [label="Router\ntyped call + context propagation"];
  caller -> client;
  client -> executor [label=" RequestEnvelope"];
  executor -> handle [label=" create Future"];
  executor -> handlers [label=" insert / poll"];
  handlers -> handle [label=" drive"];
  handle -> metadata [label=" domain methods"];
  handle -> tasks [label=" optional create_new_task"];
  handle -> router [label=" call + RequestContext"];
  router -> client [label=" downstream"];
  executor -> caller [label=" oneshot / ticket"];
}
