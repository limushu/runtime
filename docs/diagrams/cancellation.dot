digraph cancellation {
  graph [rankdir=TB, bgcolor="transparent", pad=0.3, nodesep=0.35, ranksep=0.45];
  node [shape=box, style="rounded,filled", fontname="Arial", color="#64748b", fillcolor="#f8fafc", fontcolor="#0f172a"];
  edge [fontname="Arial", color="#475569", fontcolor="#334155"];
  root [label="Cancel Disk task", fillcolor="#fee2e2", color="#dc2626"];
  scope [label="Disk TaskManager\ncancels TaskRef scope"];
  router1 [label="Disk Router cancels\nRebuild downstream task"];
  router2 [label="Rebuild Router cancels\nBG downstream task"];
  io [label="BG stops external I/O\nand waits for acknowledgement", fillcolor="#fef3c7"];
  results [label="Handler results flow upward\nTaskExit::Cancelled at root", fillcolor="#dcfce7"];
  root -> scope -> router1 -> router2 -> io -> results;
}
