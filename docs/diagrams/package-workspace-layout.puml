@startuml
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam componentStyle rectangle
left to right direction

package "pool-control-plane crate" {
  component "lib.rs\npublic domain + runtime API" as Lib

  package "runtime/（业务无关）" {
    component "service.rs\nServiceRuntime / Client / Instance\nroot Future poll" as Runtime
    component "lifecycle.rs\nControl + lifecycle" as Lifecycle
    component "observation.rs\nOperation / Trace / snapshots / events" as Observation
    component "task.rs\nTaskAttempt + TaskControl" as Task
    component "object_task.rs\nobject in-flight coordination" as ObjectTask
  }

  package "member_disk/（领域实现）" {
    component "model.rs + allocation.rs\nentity / bitmap / invariants" as Model
    component "event.rs\nUP / DOWN / Shrink input" as Event
    component "ports.rs\nMetadata / PoolNode / VDM capabilities" as Ports
    package "service/" {
      component "mod.rs\nowned committed directory" as Service
      component "client.rs\ntyped requests + private protocol" as Client
      component "runtime.rs\nManagedService adaptation\nconflict rule + task attachment" as Adapter
      component "reconcile.rs\nexecutable state table" as Reconcile
      component "operations.rs\nnormal async business actions" as Operations
      component "allocation.rs\nTier / failure-domain selection" as AllocationService
      component "error.rs" as Error
    }
  }

  component "tests/runtime_component.rs\nruntime contract tests" as RuntimeTests
  component "member_disk/service_tests.rs\nbusiness + integration tests" as DomainTests
}

component "Future Pool / PoolManager" as Pool

Lib --> Runtime
Lib --> Model
Runtime --> Lifecycle
Runtime --> Observation
Runtime --> Task
ObjectTask --> Task
Client --> Runtime
Adapter --> Runtime
Adapter --> ObjectTask
Adapter --> Reconcile
Reconcile --> Operations
Operations --> Service
AllocationService --> Service
Service --> Model
Service --> Ports
DomainTests --> Adapter
RuntimeTests --> Runtime
Pool ..> Client : will own clients/control/observer/tasks

note bottom of Runtime
通用层不出现 Disk / BG / Node 业务类型
当前先留在单 crate 内，第二个领域验证后再决定是否拆 crate
end note

note bottom of Adapter
领域只在一处适配公共运行契约
业务流程仍是 Service 上的普通 async fn
end note
@enduml
