@startuml
participant Caller
participant "Disk TaskManager" as DiskTasks
participant "Disk Handler" as Disk
participant Router
participant "Rebuild Handler" as Rebuild
participant "BG Handler" as BG

Caller -> DiskTasks : cancel(task_id)
DiskTasks -> Disk : CancellationScope
Disk -> Router : parent RequestContext cancelled
Router -> Rebuild : cancel downstream task
Rebuild -> Router : propagate cancellation
Router -> BG : cancel downstream task
BG -> BG : stop external I/O\nand await acknowledgement
BG --> Rebuild : Handler result
Rebuild --> Disk : Handler result
Disk --> Caller : TaskExit::Cancelled
@enduml
