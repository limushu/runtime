@startuml
title 视图 2：Pool 与 Service 运行容器
skinparam backgroundColor #F8FAFC
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam componentStyle rectangle
skinparam rectangle {
  RoundCorner 12
  BorderColor #334155
  BackgroundColor #FFFFFF
}

rectangle "PoolServices<HashMap<ServiceKind, ServiceEntry>>" as Pool {
  rectangle "Router\nServiceKind -> CommandHandle" as Router
  rectangle "ServiceEntry" as Entry {
    rectangle "ControlHandle\n高优先级" as Control
    rectangle "CommandHandle\n业务请求" as Command
    rectangle "ServiceObserver\n状态 + Task 事件" as Observer
    rectangle "ServiceTaskGuard\nDrop => abort 宿主" as Guard
  }
  rectangle "ServiceRuntime（唯一 tokio::spawn）" as Runtime {
    rectangle "生命周期循环\nbiased select" as Loop
    rectangle "HandlerRegistry\nKind -> free fn" as Registry
    rectangle "业务 State\nService 私有" as State
    rectangle "TaskSet\nHashMap + FuturesUnordered" as Tasks
  }
}

Control --> Loop
Command --> Loop
Loop --> Registry
Registry --> State
Registry --> Tasks : service.run(future)
Tasks --> Loop : completion message
Loop --> Observer
Router --> Command
Guard ..> Runtime : 保证整体可强制释放
note bottom of Tasks
不为每个 workflow 调用 tokio::spawn
所有 Future 由宿主 Service 统一 poll
end note
@enduml

