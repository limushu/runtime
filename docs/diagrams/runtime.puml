@startuml
left to right direction
skinparam componentStyle rectangle

actor Caller
component ServiceClient
component "Service Executor\n(one Tokio task)" as Executor
collections "HandlerSet\nFuturesUnordered" as Handlers
component "Service::handle\nasync Future" as Handle
database "Service core metadata" as Metadata
component "ServiceTaskManager\n(no Futures)" as Tasks
component Router

Caller --> ServiceClient : call / submit / send
ServiceClient --> Executor : RequestEnvelope
Executor --> Handle : create Future
Executor --> Handlers : insert / poll
Handle --> Metadata : domain methods
Handle --> Tasks : optional create_new_task
Handle --> Router : call + RequestContext
Router --> ServiceClient : typed downstream request
Executor --> Caller : oneshot / TaskTicket
@enduml
