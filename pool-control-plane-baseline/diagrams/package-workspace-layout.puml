@startuml
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam componentStyle rectangle

package "Cargo Workspace" {
  package "control-runtime crate" as Runtime {
    component Protocol
    component Context
    component ServiceClient
    component Observation
    package "service module" {
      component Contract
      component ServiceContainer
      component ObjectSlot
    }
  }

  package "pool-control-plane crate" as Pool {
    component Kernel
    component PoolManager
    component "Pool\nmetadata + assembly" as PoolInstance
    component Ports
    package "domains module" {
      component "MemberDisk\nmodel + actor + machine" as MemberDisk
      component VirtualDisk
      component PoolNode
      component Tier
      component PoolCore
    }
  }
}

Pool --> Runtime : only Cargo dependency
PoolManager --> PoolInstance : create/restore/route
PoolInstance --> MemberDisk : spawn + own
PoolInstance --> VirtualDisk : spawn + own
PoolInstance --> PoolNode : spawn + own
PoolInstance --> Ports : persist/restore
MemberDisk ..> VirtualDisk : explicit facade
MemberDisk ..> PoolNode : explicit facade
VirtualDisk ..> Tier : future explicit facade

ServiceContainer --> Contract
ServiceContainer --> ObjectSlot
ServiceClient --> Context
Observation .. ServiceContainer

note bottom of Pool
Domain 是 Rust mod
不是 Cargo crate
end note

note bottom of Runtime
完全业务无关
禁止依赖 Pool
end note
@enduml
