@startuml
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam componentStyle rectangle

package "Monitor 全局层" {
  component MonitorKernel
  component PoolManager
  component PoolRegistry
  component "DiskMap\n全局硬盘视图" as DiskMap
  component "NodeMap\n网络连通性" as NodeMap
  component "TopologyEventRouter\n候选" as TopoRouter
  component "GlobalResourceDomain\n候选：共享缓存" as GlobalResource
}

package "PoolRuntime[PoolId]" {
  component PoolCore
  component TierDomain
  component VdDomain
  component NodeDomain
  component "Domain Workflows\n位于所属Service" as Workflow
  component "Service Runtime\n候选公共机制" as ServiceRuntime
  component PoolView
  component "PoolRouter\n候选" as Router
}

package "外部端口" {
  interface SdbGateway
  interface HardwareGateway
  interface UserDpGateway
  interface VnodeGateway
}

MonitorKernel --> PoolManager
MonitorKernel --> DiskMap
MonitorKernel --> NodeMap
PoolManager --> PoolRegistry
PoolManager --> GlobalResource
PoolRegistry --> PoolCore : 管理PoolRuntime
DiskMap --> TopoRouter : 硬盘拓扑通知
NodeMap --> TopoRouter : 节点拓扑通知
TopoRouter --> PoolRegistry : 定位受影响Pool
TopoRouter --> PoolCore : 投递标准化事实

PoolCore --> Router
Router --> TierDomain
Router --> VdDomain
Router --> NodeDomain
Workflow ..> Router : 跨领域能力
ServiceRuntime --> Workflow : poll Future
ServiceRuntime --> Router : 请求分发/上下文传播
PoolCore --> PoolView
TierDomain --> PoolView
VdDomain --> PoolView
NodeDomain --> PoolView

PoolCore ..> SdbGateway
TierDomain ..> SdbGateway
VdDomain ..> SdbGateway
NodeDomain ..> SdbGateway
TierDomain ..> DiskMap : 查询物理盘视图
NodeDomain ..> NodeMap : 查询网络连通性
NodeDomain ..> UserDpGateway
VdDomain ..> UserDpGateway
PoolView ..> VnodeGateway
DiskMap ..> HardwareGateway
NodeMap ..> UserDpGateway : 连通性
GlobalResource ..> DiskMap
GlobalResource ..> SdbGateway

note bottom of Workflow
不预设万能WorkflowService
Workflow属于最终结果的领域
end note

note bottom of Router
提供call / submit / query
Task不是通信能力所有者
end note
@enduml
