@startuml
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam componentStyle rectangle
left to right direction

rectangle "Pool" as Pool {
  component Lifecycle
  component Health
  component "Activity Set" as Activity
}

rectangle "MemberDisk" as MD {
  database "MemberDiskRecord (SDB)\nidentity/tier/capacity/topology\nallocation/membership/bitmap/revision" as Record
  component "Physical Observation\nDiskMap: UP / DOWN" as PhysicalState
  component "Operational Projection\nUA / DA / DI / UI / REMOVED" as DiskState
  component "ObjectActivity\nObjectSlot: intent only" as ObjectActivity
}

rectangle "PoolNode" as PN {
  component Membership
  component "Connectivity\n来自NodeMap" as Connectivity
  component "Pool ServiceState" as ServiceState
}

rectangle "BGEntry" as Entry {
  component "MediaState\n由MemberDisk派生" as MediaState
  component DataState
}

Entry --> Health : BG -> VD -> Pool派生
MD --> MediaState : 物理状态输入
Record --> DiskState : allocation + membership
PhysicalState --> DiskState : observation
ObjectActivity ..> DiskState : 只参与准入，不拥有状态
Connectivity --> ServiceState : 必要但不充分

note bottom of Pool
PoolState = Lifecycle × Health × Activity
end note

note bottom of PN
Connected(n) 不代表 PoolServing(p,n)
end note

note bottom of MD
Record / Observation / Projection / Activity 四层分离
逻辑Actor拥有前三层，ObjectSlot拥有Activity
end note
@enduml
