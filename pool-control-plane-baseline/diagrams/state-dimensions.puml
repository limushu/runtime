@startuml
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam componentStyle rectangle
left to right direction

rectangle "Pool" as Pool {
  component Lifecycle
  component Health
  component "Activity Set" as Activity
}

rectangle "MemberDisk" as MD {
  database "Persisted decision fields (SDB)\nidentity/tier/capacity/topology\nallocation/membership/bitmap/revision" as Decision
  component "Physical Observation\nDiskMap: UP / DOWN" as PhysicalState
  component "Operational Projection\nUA / DA / DI / UI / REMOVED" as DiskState
}

rectangle "Service Runtime (private)" as Runtime {
  component "ActorCell Activity\nintent only" as ActorActivity
}

rectangle "PoolNode" as PN {
  component Membership
  component "Connectivity\n来自NodeMap" as Connectivity
  component "Pool ServiceState" as ServiceState
}

rectangle "BGEntry" as Entry {
  component "MediaState\n由MemberDisk派生" as MediaState
  component DataState
}

Entry --> Health : BG -> VD -> Pool派生
MD --> MediaState : 物理状态输入
Decision --> DiskState : allocation + membership
PhysicalState --> DiskState : observation
ActorActivity ..> DiskState : 不参与状态机，仅管理执行
Connectivity --> ServiceState : 必要但不充分

note bottom of Pool
PoolState = Lifecycle × Health × Activity
end note

note bottom of PN
Connected(n) 不代表 PoolServing(p,n)
end note

note bottom of MD
Decision fields / Observation / Projection 与执行活动分离
MemberDisk拥有前三层；Runtime私有ActorCell拥有Activity
end note
@enduml
