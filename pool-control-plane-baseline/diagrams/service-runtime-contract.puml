@startuml
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam componentStyle rectangle
left to right direction

actor "业务开发者" as Developer

package "Domain Service" {
  component "Domain Object\n完整业务元数据" as Object
  component "State Machine\nTransition::to(...).change(...).ensure(...)" as Machine
  component "Query async fn\n不强制创建Task" as Query
  component "Workflow async fn\n自然业务编排" as Workflow
  database "Private Domain State" as State
}

package "Service Runtime" {
  component "Control Channel\nPause / Resume / Drain / Stop" as Control
  component "Business Channel\nQuery / Call / Submit" as Business
  component "Static Dispatch" as Dispatch
  component "ActorCell Registry (private)\nStart / Join / Replace / Queue" as ActorCell
  component "Workflow Set\npoll Futures" as Futures
  component "Task Registry\nAttempt + parent/child" as Tasks
  component "Observation\nIdle/Busy + progress + trace" as Observation
}

component "Domain Service Facade\nnamed methods" as Facade
component "Typed ServiceClient\nexplicit instance + oneshot" as Client
component "Other Domain Services" as Other

Developer --> Query : 编写
Developer --> Workflow : 编写
Developer --> Object : 编写
Developer --> Machine : 编写
Business --> Dispatch
Control --> Futures : 控制生命周期
Dispatch --> Query
Dispatch --> Machine : state + event
Object --> Machine : current state
Machine --> ActorCell : ensure desired workflow
ActorCell --> Futures : start / join / replace
Futures --> Workflow : poll
Workflow --> State : 短临界区读写
Workflow --> Facade : named capability
Facade --> Client
Client --> Other : context + stable cancellation
Futures --> Tasks
Tasks --> Observation
ActorCell --> Observation

note bottom of Developer
不编写TaskSpec、BoxFuture、move闭包
不管理channel、oneshot、JoinHandle
不实现Actor或读取在途活动
end note

note bottom of State
只有所属Service可修改
不得把可变访问跨过await
end note

note bottom of ActorCell
完全隐藏在Runtime
一个对象不是一个Tokio task
不保存业务状态副本
end note
@enduml
