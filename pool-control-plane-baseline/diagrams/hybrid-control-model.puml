@startuml
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam componentStyle rectangle

package "输入事实与命令" {
  component Command
  component "DiskMap Fact" as DiskFact
  component "NodeMap Fact" as NodeFact
  component Timer
  component EffectResult
}

package "Pool" {
  component PoolIngress

  package "领域状态与策略" {
    component PoolCore
    component "MemberDisk Object\nRecord + Observation" as DiskObject
    component "MemberDisk StateMachine\n(state,event) -> Transition" as DiskFSM
    component "PoolNode FSM" as NodeFSM
    component "VD / BG FSM" as BgFSM
  }

  component "Domain Workflows\nService上的async fn" as Workflow
  component "Reconcile\n状态收敛" as Reconcile
  component PoolView
}

package "执行机制" {
  component "ActorCell (private)\nStart / Join / Replace / Queue" as ActorCell
  component "Service Runtime" as Runtime
  component "Explicit Facade + ServiceClient" as Client
  component "Task / Future / Cancel / Trace" as Task
}

package "外部能力" {
  database SDB
  component user_dp
  component VNODE
}

Command --> PoolIngress
DiskFact --> PoolIngress
NodeFact --> PoolIngress
Timer --> PoolIngress
EffectResult --> PoolIngress

PoolIngress --> PoolCore
PoolIngress --> DiskObject
DiskObject --> DiskFSM : state + event
PoolIngress --> NodeFSM
PoolIngress --> BgFSM

DiskFSM --> ActorCell : ensure desired workflow
NodeFSM --> ActorCell : ensure desired workflow
BgFSM --> ActorCell : ensure desired workflow
ActorCell --> Workflow : start / join / replace
Workflow --> Client : 命名跨领域能力
Workflow --> Runtime : 业务Future
Runtime --> Task
Client --> Runtime : 明确目标服务请求
Task --> SDB
Task --> user_dp
Task --> VNODE
SDB --> EffectResult
user_dp --> EffectResult
VNODE --> EffectResult

Reconcile --> PoolCore
Reconcile --> DiskObject
Reconcile --> NodeFSM
Reconcile --> BgFSM
SDB --> Reconcile : 已提交决策
user_dp --> Reconcile : 实际状态

PoolCore --> PoolView
DiskObject --> PoolView
NodeFSM --> PoolView
BgFSM --> PoolView

note right of DiskFSM
开发者只声明下一状态和目标Workflow
不读取Actor活动
end note

note right of Runtime
只负责执行，不拥有业务真相
Operation Context不是状态机
ActorCell不进入领域API
end note
@enduml
