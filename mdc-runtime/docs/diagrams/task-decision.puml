@startuml
start
:Executor calls Service::handle;
:HandlerSet polls Handler Future;
if (workflow needs control scope?) then (no)
  :continue normal async workflow;
else (yes)
  :Service::create_new_task;
  :ServiceTaskManager applies TaskKey policy;
  if (slot available?) then (yes)
    :return TaskContext;
  else (replace)
    :cancel old Task;
    :current Handler Future Pending;
    :resume after old Handler exits;
  endif
endif
:Handler returns Result;
:Executor completes reply / TaskTicket;
stop
@enduml
