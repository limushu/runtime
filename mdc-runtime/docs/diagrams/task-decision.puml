@startuml
start
:Service::handle(request);
:route to Service member method;
if (workflow needs managed task?) then (no)
  :HandleResult::Reply;
  :send oneshot response;
else (yes)
  :workflow builds TaskSpec;
  :HandleResult::Task;
  :TaskSet checks TaskKey;
  :poll workflow Future;
  :send TaskExit;
endif
stop
@enduml
